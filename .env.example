# Copiá este archivo como .env.local y completá los valores.
# .env.local nunca se sube a GitHub.

# Supabase: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Dirección del sitio. En tu compu es http://localhost:3000.
# En Netlify no hace falta: se toma sola.
APP_URL=http://localhost:3000

# Secreto para la huella de los teléfonos (antifraude). Mínimo 32 caracteres.
# Generalo una vez con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No lo cambies después: las huellas viejas dejarían de coincidir.
PHONE_HMAC_SECRET=
